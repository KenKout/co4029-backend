# aBridgeAI backend-new — local dev defaults.
# Custom ports avoid colliding with legacy backend/'s containers.
# Copy to `.env` for local runs: cp .env.example .env

APP_NAME="aBridgeAI API"
ENVIRONMENT=local

# CORS — comma-separated list (note: backend-new uses ALLOWED_ORIGINS, not legacy
# CORS_ORIGINS JSON-array form). Empty string disables the CORS middleware.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# =============================================================================
# Postgres (compose maps 5433 host -> 5432 container)
# =============================================================================
DATABASE_URL=postgresql+psycopg://abridgeai:abridgeai@localhost:5433/abridgeai

# Connection pool (matches core/config.py defaults)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=15
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# =============================================================================
# Redis (compose maps 6380 host -> 6379 container)
# =============================================================================
REDIS_URL=redis://localhost:6380/0

# =============================================================================
# Auth — replace JWT_SECRET_KEY in any non-local environment.
# =============================================================================
JWT_SECRET_KEY=dev-only-secret-replace-in-production-32+
ACCESS_TOKEN_TTL_SECONDS=900
SESSION_TTL_SECONDS=2592000

# Google OAuth (optional). Empty = OAuth disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# =============================================================================
# Characterization harness (T0.11) — URLs the snapshot/replay CLIs hit.
# =============================================================================
OLD_BACKEND_URL=http://localhost:8000
NEW_BACKEND_URL=http://localhost:8001

# =============================================================================
# Observability (T0.24)
# LOG_FORMAT: "console" (dev, colored human output) or "json" (CI/prod)
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR | CRITICAL
# =============================================================================
LOG_FORMAT=console
LOG_LEVEL=INFO

# =============================================================================
# LLM (chat completions). One OpenAI-compatible endpoint covers OpenAI,
# OpenRouter, vLLM, LM Studio, Ollama, and any other compatible server.
# =============================================================================
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_DEFAULT_TIER=standard
LLM_MODEL_SMALL=gpt-4o-mini
LLM_MODEL_STANDARD=gpt-4o-mini
LLM_MODEL_LARGE=gpt-4o
LLM_TIMEOUT_SECONDS=60
# Whitelist enforced: HTTP-Referer, X-Title, User-Agent only.
LLM_EXTRA_HEADERS_JSON=
# Optional per-role overrides. Empty = use the tier mapping.
LLM_MODEL_EXTRACTION=
LLM_MODEL_ENRICHMENT=
LLM_MODEL_IDEATION=
LLM_MODEL_GENERATION=
LLM_MODEL_VALIDATION=
LLM_MODEL_CHUNKING_ENRICHMENT=
LLM_MODEL_KG_EXTRACTION=
LLM_MODEL_STT=
LLM_MODEL_VISION=

# =============================================================================
# Embeddings. Independent OpenAI-compatible endpoint.
# EMBEDDING_DIMENSIONS must match the document_chunks.embedding pgvector
# column width. Baseline = halfvec(3072) for text-embedding-3-large; switch
# to halfvec(1536) via migration if using text-embedding-3-small.
# =============================================================================
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072
EMBEDDING_TIMEOUT_SECONDS=30

# =============================================================================
# Knowledge graph (Neo4j). Compose maps 7475 host -> 7474 container (HTTP)
# and 7688 host -> 7687 container (Bolt) to avoid colliding with legacy.
# Set KNOWLEDGE_GRAPH_ENABLED=true to enable KG ingestion + queries.
# =============================================================================
KNOWLEDGE_GRAPH_ENABLED=false
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=abridgeai-neo4j-dev
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_POOL_SIZE=50

# =============================================================================
# AWS S3 / Garage object storage. Compose maps 3910 host -> 3900 container
# to avoid colliding with legacy backend/'s garage on 3900.
# Leave AWS_* blank to fall back to mock presigned URLs (no compose deps).
# =============================================================================
AWS_ACCESS_KEY_ID=GK1234567890abcdef1234567890abcdef
AWS_SECRET_ACCESS_KEY=1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef
AWS_REGION=garage
AWS_ENDPOINT_URL=http://localhost:3910
# Public endpoint embedded in presigned URLs (browser-reachable).
AWS_PUBLIC_ENDPOINT_URL=http://localhost:3910
S3_BUCKET_NAME=abridgeai-local
S3_URL_TTL_SECONDS=900

# =============================================================================
# AI pipeline tunables.
# =============================================================================
QUIZ_COVERAGE_PARALLELISM=6

# 5-stage chunking pipeline. Stage A (structural) and B (semantic glue) are
# always-on free. Stage C (LLM enrichment) costs ~$0.005/doc with gpt-4o-mini.
CHUNKING_MAX_TOKENS=400
CHUNKING_OVERLAP_TOKENS=50
CHUNKING_SEMANTIC_GLUE_ENABLED=true
CHUNKING_SEMANTIC_GLUE_THRESHOLD=0.72
CHUNKING_SEMANTIC_GLUE_MAX_WINDOW_TOKENS=2000
CHUNKING_SEMANTIC_GLUE_MIN_WINDOW_TOKENS=30
CHUNKING_LLM_ENRICHMENT_ENABLED=false
CHUNKING_LLM_PROPOSITIONS_ENABLED=false
CHUNKING_LLM_CONTEXTUAL_RETRIEVAL_ENABLED=false
CHUNKING_LLM_PARALLELISM=4
CHUNKING_CACHE_ENABLED=true

# =============================================================================
# Spaced repetition + AI cost guards.
# =============================================================================
SR_FAILURE_COOLDOWN_SECONDS=86400
AI_DAILY_USER_SPEND_WARN_USD=5.0

# =============================================================================
# Multimedia processing.
# =============================================================================
# Audio/video transcription (material ingestion STT).
# AUDIO_EXTRACTION_LOCAL=true forces local faster-whisper (audio-local extra) —
# avoid in API-only deployments. When false, AUDIO_STT_PROVIDER picks the cloud
# backend:
#   'deepgram'    => Deepgram /v1/listen with DEEPGRAM_API_KEY (API-only,
#                    EN+VI via detect_language, DEEPGRAM_STT_MODEL below).
#   'whisper_api' => OpenAI-compatible gateway /audio/transcriptions (needs the
#                    gateway to serve a model named by WHISPER_MODEL).
AUDIO_EXTRACTION_LOCAL=false
AUDIO_STT_PROVIDER=deepgram
# Deepgram STT model (used when AUDIO_STT_PROVIDER=deepgram). nova-2 handles
# both EN and VI; language is detected per-file at runtime.
DEEPGRAM_STT_MODEL=nova-2
# Image OCR backend. 'llm_vision' (default) sends the image to the multimodal
# VISION model via the API (no local binary) — matches the API-only deployment
# rule. 'tesseract' uses a local tesseract-ocr binary + IMAGE_OCR_LANG packs.
IMAGE_OCR_PROVIDER=llm_vision
# Tesseract language(s), '+'-joined traineddata names — only used when
# IMAGE_OCR_PROVIDER=tesseract. Bilingual EN/VI needs both; install with:
# apt install tesseract-ocr-eng tesseract-ocr-vie
IMAGE_OCR_LANG=eng+vie
FFMPEG_PATH=ffmpeg
# STT model name as exposed by the API gateway. Audio/video transcription
# fails until the gateway serves a model under this name.
WHISPER_MODEL=whisper-1
VIDEO_FRAME_SAMPLE_FPS=1.0

# --- Ingestion preprocessing (abridgeai/ai/preprocessing) ---------------------
# Noise filtering between extraction and chunking: blank/image-only pages,
# running headers/footers, page numbers, cover + instructor blocks, TOC,
# references, closing slides, slide-deck grouping, unicode + de-hyphenation.
# Nothing is hard-deleted — every decision is recorded with a reason code under
# learning_material_versions.extracted_metadata['preprocess'], so changing a
# threshold is a config change, not a re-index. Set PREPROCESS_ENABLED=false to
# fall straight back to raw extraction.
PREPROCESS_ENABLED=true
PREPROCESS_DEHYPHENATION=true
PREPROCESS_RUNNING_MARKS=true
PREPROCESS_PAGE_ROLES=true
PREPROCESS_DECK_DETECTION=true
# OCR for image-only PDF pages via LLMRole.PAGE_OCR, which resolves to the
# SMALL tier (LLM_MODEL_SMALL) — this deployment has no GPU, so the API path is
# the only path. Without it a diagram slide carrying a four-word title indexes
# as almost nothing. COST: one vision call per image-only page.
PREPROCESS_OCR_ENABLED=true
PREPROCESS_OCR_DPI=150
# Hard cap per document. Above this the upload is a scan, and the pipeline logs
# loudly and stops rather than quietly running up a per-page vision bill.
PREPROCESS_OCR_MAX_PAGES=30
# LLM adjudication of the ~5-15% of pages the deterministic rules cannot
# settle, batched 10 per call on the SMALL tier. Rule-based classification
# beats an LLM on both accuracy and latency for the clear-cut cases, so this
# deliberately only ever sees the residue. Set false to run rules-only (free).
PREPROCESS_LLM_ADJUDICATION=true
PREPROCESS_LLM_MIN_CONFIDENCE=0.8

# =============================================================================
# Deepgram TTS for browser-played interview narration (REST path only).
# When DEEPGRAM_API_KEY is set, ENGLISH narration uses Deepgram Aura-2 voices.
# Vietnamese narration ALWAYS falls back to the OpenAI-compatible TTS gateway
# (Deepgram TTS is English-only). Leave the key unset to use the gateway for
# all narration exactly as before (additive, default-off).
# =============================================================================
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_BASE_URL=https://api.deepgram.com/v1
DEEPGRAM_TTS_MODEL_EN=aura-2-thalia-en
DEEPGRAM_TTS_ENCODING=mp3
DEEPGRAM_TTS_TIMEOUT_SECONDS=30.0

# Cartesia TTS — Vietnamese voice for realtime interviews (sonic-3).
# Empty/unset => VI sessions fall back to the OpenAI-compatible gateway TTS.
CARTESIA_API_KEY=
CARTESIA_TTS_MODEL=sonic-3
CARTESIA_TTS_VOICE_VI=0e58d60a-2f1a-4252-81bd-3db6af45fb41

# =============================================================================
# LiveKit voice interview (Phase 1+). Target: LiveKit Cloud.
# Leave INTERVIEW_VOICE_ENABLED=false to keep text-only interviews. When true,
# all three LIVEKIT_* values are required (validated at startup). Get the WS URL
# + API key/secret from your LiveKit Cloud project settings.
# =============================================================================
INTERVIEW_VOICE_ENABLED=false
LIVEKIT_WS_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=interview-agent
INTERVIEW_VOICE_TOKEN_TTL_SECONDS=900
# Safety net: voice sessions whose interview config has NO time_limit_minutes are
# finalised by the stale-session sweep once idle (no new message) for this many
# minutes, so an abandoned session can't stay in_progress forever (1..1440).
INTERVIEW_VOICE_IDLE_TIMEOUT_MINUTES=30
# Machine-CPU fraction (0..1, exclusive) above which the interview agent worker
# reports itself unavailable and LiveKit stops dispatching to it. It measures
# the whole host, not the worker, so the SDK default of 0.7 is tripped by
# co-located API/arq processes on a shared box. Lower it only if interviews
# themselves are saturating the host -- then prefer a second worker.
INTERVIEW_VOICE_LOAD_THRESHOLD=0.9

# Prompt-injection protection rollout. Keep production at shadow until red-team
# and human voice sign-off are complete. Roll back enforce -> shadow normally;
# off is emergency-only and disables blocking.
INTERVIEW_SECURITY_GUARD_MODE=shadow
INTERVIEW_SECURITY_ALLOW_SESSION_TERMINATION=false

# Split answer analysis so the rubric-bearing call never receives raw student
# text (quarantined extractor -> deterministic claim screen -> matcher). Start
# at shadow: it runs both paths, records the divergence, and still returns the
# legacy result, so measurement cannot regress a learner. Roll back
# enforce -> shadow; off restores the single legacy call.
INTERVIEW_ANALYSIS_SPLIT_MODE=off
