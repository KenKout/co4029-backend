# Copy to .env (or export) and adjust. Only ACCESS_TOKEN/REFRESH_TOKEN are
# strictly required; everything else has working defaults.

# Target deployment (default https://abridgeai.tech).
# Use http://192.168.1.41:8000 to bypass TLS and hit Uvicorn directly
# (matches the LAN methodology of the previous evaluation).
#BASE_URL=https://abridgeai.tech

# Auth — refresh tokens ROTATE on every use; refresh-token.sh persists the
# latest one under .state/. Set REFRESH_TOKEN once (first run), afterwards
# run.sh keeps itself alive.
#REFRESH_TOKEN=
#ACCESS_TOKEN=

# Business ids probed on the DWDSS course (defaults in config.js).
#QUIZ_ID=d3e2fe10-19b7-482d-bb68-37a793a3f4fa
#COURSE_ID=e5ba475d-140e-4a82-9a6b-b283b8e760ac
#INTERVIEW_CONFIG_ID=caec31d5-cb16-486d-b4fa-b9b522d9bee6

# Load shaping.
#VUS=50
#DURATION=2m
#THINK_TIME_S=2
#HEARTBEAT_EVERY_N_ANSWERS=2
#SR_CARDS_PER_ITER=3
#INTERVIEW_TURNS=0            # each turn costs LLM tokens!
#RAMP_PROFILE=50:30s,100:1m,150:1m,200:1m
